# 强制 OpenSSL 使用 TLS 1.2。
# 原因：本机 Python 3.10 默认走 TLS 1.3 时，访问 pypi.org / download.pytorch.org
# 会在握手中被重置（SSLEOFError），而 curl 正常；限定 TLS 1.2 后可稳定下载。
# 用法：$env:OPENSSL_CONF = "<此文件绝对路径>" 后再运行 python/pip。
openssl_conf = openssl_init
[openssl_init]
ssl_conf = ssl_sect
[ssl_sect]
system_default = system_default_sect
[system_default_sect]
MinProtocol = TLSv1.2
MaxProtocol = TLSv1.2
